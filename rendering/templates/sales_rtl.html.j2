<!doctype html>
<html lang="he" dir="rtl">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ name }} - {{ headline_text }} - CV</title>
  <style>
    @page { size: A4; margin: 0; }
    * { box-sizing: border-box; }
    html, body { margin: 0; width: 210mm; direction: rtl; color: #20242b; font-family: Arial, "Noto Sans Hebrew", sans-serif; font-size: 9.8pt; line-height: 1.38; }
    .page { width: 210mm; min-height: 297mm; padding: 12mm 14mm 10mm; overflow: hidden; }
    header { border-right: 4px solid #237568; padding: 1mm 5mm 3.5mm 0; display: flex; justify-content: space-between; gap: 10mm; }
    h1 { margin: 0; font-size: 24pt; line-height: 1; }
    .headline { margin-top: 1.6mm; color: #237568; font-size: 10.5pt; font-weight: 700; }
    .contacts { text-align: left; direction: ltr; color: #56616d; font-size: 8.4pt; }
    .contacts a { color: inherit; text-decoration: none; }
    section { margin-top: 3.7mm; break-inside: avoid; }
    h2 { margin: 0 0 1.6mm; color: #237568; border-bottom: 1px solid #c9d8d5; padding-bottom: .7mm; font-size: 9pt; }
    p { margin: 0 0 1.3mm; }
    h3 { margin: 1.5mm 0 0; font-size: 10.2pt; }
    .date { color: #64707c; font-size: 8.3pt; margin: .2mm 0 .9mm; }
    .bullet { display: grid; grid-template-columns: 3.2mm 1fr; margin: 0 0 .75mm; }
    .bullet-dot { font-weight: 700; }
    .item { margin: 0 0 .75mm; }
    bdi[dir="ltr"] { unicode-bidi: isolate; }
    .claim { break-inside: avoid; }
  </style>
</head>
<body>
<main class="page" data-cv-page>
  <header>
    <div><h1>{{ name }}</h1><div class="headline">{{ headline }}</div></div>
    <div class="contacts">{% for contact in contacts %}<div>{{ contact }}</div>{% endfor %}</div>
  </header>
  {% for section in sections %}
  <section data-section="{{ section.name }}">
    <h2>{{ section.name }}</h2>
    {% for claim in section.claims %}
      {% if claim.style == "heading" %}<h3 class="claim">{{ claim.html }}</h3>
      {% elif claim.style == "date" %}<div class="date claim">{{ claim.html }}</div>
      {% elif claim.style == "paragraph" %}<p class="claim">{{ claim.html }}</p>
      {% elif claim.style == "item" %}<div class="item claim">{{ claim.html }}</div>
      {% else %}<div class="bullet claim"><span class="bullet-dot">•</span><span>{{ claim.html }}</span></div>{% endif %}
    {% endfor %}
  </section>
  {% endfor %}
</main>
</body>
</html>
