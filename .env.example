# Template for local configuration. Copy to `.env` and fill in real values:
#
#     cp .env.example .env
#
# `.env` is git-ignored; this file is committed and must never hold a real
# credential. A variable exported in your shell wins over anything set here,
# so an explicit `export` still overrides the file.

# --- Workspace selection -------------------------------------------------
# Absolute path to the Workspace to open. Unset uses the repository root.
# CV_WORKSPACE=/path/to/workspace

# --- Database ------------------------------------------------------------
# Secret: carries the PostgreSQL password. The value below is the local
# docker-compose default, which is not a real credential.
CV_DATABASE_URL=postgresql+psycopg://cv:cv@127.0.0.1:5433/cv

# --- AI provider ---------------------------------------------------------
# Secret. Leave unset for the deterministic offline workflow: with no key
# configured no AI adapter is built at all, and the workflow still reaches
# Ready.
# OPENAI_API_KEY=sk-replace-me
CV_PROVIDER=deterministic
CV_MODEL=gpt-5.6

# --- API -----------------------------------------------------------------
# CV_API_MAX_BODY_BYTES=2097152
# The single development Vite origin - never a wildcard, never a list.
# CV_API_DEV_ORIGIN=http://127.0.0.1:5173

# --- Immutable payload storage -------------------------------------------
# "local" keeps payloads on the Workspace filesystem; "s3" uses a bucket.
CV_OBJECT_STORE=local
# CV_S3_BUCKET=my-bucket
# CV_S3_PREFIX=cv/
# Set for R2 or MinIO; unset for AWS S3.
# CV_S3_ENDPOINT_URL=https://accountid.r2.cloudflarestorage.com
# CV_S3_REGION=auto
#
# AWS credentials are read from the ambient environment by boto3, not by this
# config. Set them here only if you use the s3 backend.
# AWS_ACCESS_KEY_ID=replace-me
# AWS_SECRET_ACCESS_KEY=replace-me
