  "concepts": {
    "english-proficiency": {
      "label": "English proficiency",
      "kind": "threshold",
      "patterns": [
        "native english[a-z ]*",
        "english[^.;]{0,24}native",
        "fluent english[a-z ]*",
        "english[^.;]{0,24}fluent"
      ],
      "scale": "language_proficiency",
      "demand_terms": {
        "native": [
          "native"
        ],
        "fluent": [
          "fluent"
        ]
      },
      "value_fact_ids": [
        "common.language.english"
      ],
      "value_source": "scale_term",
      "candidate_fact_ids": [
        "common.language.english"
      ]
    },
    "sales-closing-experience-years": {
      "label": "Years of sales closing experience",
      "kind": "threshold",
      "patterns": [
        "\\d+\\+?\\s*years?[^.;]{0,60}(?:sales|closing|quota)",
        "(?:sales|closing)[^.;]{0,40}\\d+\\+?\\s*years?"
      ],
      "scale": "years",
      "demand_pattern": "(\\d+)\\s*\\+?\\s*years?",
      "value_fact_ids": [
        "sales.summary.tenure"
      ],
      "value_source": "effective_dates_years",
      "candidate_fact_ids": [
        "sales.summary.tenure"
      ]
    },
    "technology-company-sales": {
      "label": "Sales experience at a technology company",
      "kind": "compositional",
      "patterns": [
        "sales[^.;]{0,120}(?:technology|tech|software|saas)\\s+compan\\w*",
        "(?:technology|tech|software|saas)\\s+compan\\w*[^.;]{0,120}sales"
      ],
      "components": [
        {
          "component_id": "sales-experience",
          "label": "B2B sales experience",
          "satisfied_by_tags": [
            "sales"
          ]
        },
        {
          "component_id": "technology-company-sales-context",
          "label": "Sales carried out at a technology company",
          "satisfied_by_fact_ids": [],
          "satisfied_by_tags": []
        }
      ],
      "boundary_fact_ids": [
