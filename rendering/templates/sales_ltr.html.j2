<!doctype html>
<html lang="en" dir="ltr">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ name }} - {{ headline_text }} - CV</title>
  <style>
    @page { size: A4; margin: 0; }
    * { box-sizing: border-box; }
    html, body { margin: 0; width: 210mm; color: #20242b; font-family: Arial, Helvetica, sans-serif; font-size: 9.6pt; line-height: 1.32; }
    .page { width: 210mm; min-height: 297mm; padding: 12mm 14mm 10mm; overflow: hidden; }
    header { border-left: 4px solid #237568; padding: 1mm 0 3.5mm 5mm; display: flex; justify-content: space-between; gap: 10mm; }
    h1 { margin: 0; font-size: 24pt; line-height: 1; }
    .headline { margin-top: 1.6mm; color: #237568; font-size: 10.5pt; font-weight: 700; }
    .contacts { text-align: right; color: #56616d; font-size: 8.4pt; }
    .contacts a { color: inherit; text-decoration: none; }
    section { margin-top: 3.7mm; break-inside: avoid; }
    h2 { margin: 0 0 1.6mm; color: #237568; border-bottom: 1px solid #c9d8d5; padding-bottom: .7mm; font-size: 8pt; letter-spacing: 1px; text-transform: uppercase; }
    p { margin: 0 0 1.3mm; }
    h3 { margin: 1.5mm 0 0; font-size: 10.2pt; }
    .date { color: #64707c; font-size: 8.3pt; margin: .2mm 0 .9mm; }
    .bullet { display: grid; grid-template-columns: 3.2mm 1fr; margin: 0 0 .75mm; }
    .bullet-dot { font-weight: 700; }
    .item { margin: 0 0 .75mm; }
    .claim { break-inside: avoid; }
    strong { font-weight: 700; }
    .page.spacious { font-size: 10.3pt; line-height: 1.38; padding: 13mm 16mm 10mm; }
    .page.spacious header { padding: 1.3mm 0 4.2mm 5.5mm; }
    .page.spacious h1 { font-size: 25pt; }
    .page.spacious .headline { margin-top: 1.8mm; font-size: 11pt; }
    .page.spacious .contacts { font-size: 8.8pt; line-height: 1.34; }
    .page.spacious section { margin-top: 4.5mm; }
    .page.spacious h2 { margin-bottom: 1.8mm; padding-bottom: .8mm; font-size: 8.5pt; }
    .page.spacious p { margin-bottom: 1.6mm; }
    .page.spacious h3 { margin-top: 1.8mm; font-size: 10.8pt; }
    .page.spacious .date { font-size: 8.8pt; margin: .3mm 0 1.05mm; }
    .page.spacious .bullet { grid-template-columns: 3.6mm 1fr; margin-bottom: .95mm; }
    .page.spacious .item { margin-bottom: .95mm; }
    .page.compact { font-size: 9.1pt; line-height: 1.26; padding: 10mm 14mm 8mm; }
    .page.compact header { padding-bottom: 3mm; }
    .page.compact section { margin-top: 3.1mm; }
    .page.compact h2 { margin-bottom: 1.35mm; padding-bottom: .55mm; }
    .page.compact h3 { margin-top: 1.25mm; font-size: 9.9pt; }
    .page.compact .date { margin-bottom: .7mm; }
    .page.compact .bullet, .page.compact .item { margin-bottom: .55mm; }
  </style>
</head>
<body>
<main class="page{% if layout_class %} {{ layout_class }}{% endif %}" data-cv-page>
  <header>
    <div><h1>{{ name }}</h1><div class="headline">{{ headline }}</div></div>
    <div class="contacts">{% for contact in contacts %}<div>{{ contact }}</div>{% endfor %}</div>
  </header>
  {% for section in sections %}
  <section data-section="{{ section.name }}">
    <h2>{{ section.name }}</h2>
    {% for claim in section.claims %}
      {% if claim.style == "heading" %}<h3 class="claim">{{ claim.html }}</h3>
      {% elif claim.style == "date" %}<div class="date claim">{{ claim.html }}</div>
      {% elif claim.style == "paragraph" %}<p class="claim">{{ claim.html }}</p>
      {% elif claim.style == "item" %}<div class="item claim">{{ claim.html }}</div>
      {% else %}<div class="bullet claim"><span class="bullet-dot">•</span><span>{{ claim.html }}</span></div>{% endif %}
    {% endfor %}
  </section>
  {% endfor %}
</main>
</body>
</html>
