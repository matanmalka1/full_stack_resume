{
  "projectId": "1f93d94a-ca99-486f-8954-d3885540a632",
  "shape": "package",
  "pkg": "cv-application-frontend",
  "globalName": "cvUI",
  "srcDir": "src/ui",
  "cssEntry": ".ds-styles.css",
  "tsconfig": "tsconfig.app.json",
  "runtimeFontPrefixes": ["Heebo", "Assistant", "Rubik", "Arial Hebrew", "Noto Sans Hebrew"],
  "componentSrcMap": {"QueryState": null},
  "overrides": {"Dialog": {"cardMode": "single", "primaryStory": "OpenState"}},
  "buildCmd": "cd frontend && npx vite build && CSS=$(ls dist/assets/*.css | head -1) && { printf '@import \"./fonts/heebo.css\";\\n'; cat \"$CSS\"; } > .ds-styles.css"
}
