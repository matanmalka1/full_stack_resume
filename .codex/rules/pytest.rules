prefix_rule(
    pattern = ["./.venv/bin/python", "-m", "pytest"],
    decision = "allow",
    justification = "Playwright rendering tests require Chrome outside the macOS Seatbelt sandbox",
    match = [
        "./.venv/bin/python -m pytest -q",
        "./.venv/bin/python -m pytest -q tests/test_rendering.py",
    ],
)
