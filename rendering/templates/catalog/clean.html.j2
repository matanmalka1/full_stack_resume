{% extends "catalog/base.html.j2" %}
{#- Resume Matcher clean: all sans, a light name, large understated gray headings over a thin rule. No letter-spacing: the original spaced its headings apart in the PDF text. -#}
{% block design %}
    :root { --head-font: var(--sans); }
    h1 { font-weight: 400; }
    .headline { color: var(--muted); }
    h2 { color: var(--muted); font-weight: 600; text-transform: uppercase; font-size: 11.5pt; border-bottom: 1px solid var(--rule); padding-bottom: .5mm; }
{% endblock %}
