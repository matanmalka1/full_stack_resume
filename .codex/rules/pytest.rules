prefix_rule(
    pattern = ["./.venv/bin/python", "-m", "pytest"],
    decision = "allow",
    justification = "Run tests with the dedicated v2-worktree virtualenv; browser tests require Chromium outside the macOS Seatbelt sandbox",
    match = [
        "./.venv/bin/python -m pytest -q",
        "./.venv/bin/python -m pytest -q tests/test_rendering.py",
    ],
)

prefix_rule(
    pattern = ["env", "CV_REQUIRE_BROWSER=1", "./.venv/bin/python", "-m", "pytest"],
    decision = "allow",
    justification = "Run the complete acceptance suite with the dedicated v2-worktree virtualenv and mandatory browser coverage",
    match = [
        "env CV_REQUIRE_BROWSER=1 ./.venv/bin/python -m pytest -q -m \"\"",
    ],
)
