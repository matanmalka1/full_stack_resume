{% extends "catalog/base.html.j2" %}
{#- Resume Matcher modern-two-column: accent headings and an accent divider in a 65:35 grid. -#}
{% block design %}
    h1 { display: inline-block; padding-bottom: 1mm; border-bottom: 1mm solid var(--accent); }
    h2 { color: var(--accent); text-transform: uppercase; border-bottom: 2px solid var(--accent); padding-bottom: .5mm; font-size: 10pt; }
    .headline { color: var(--muted); }
    .columns { grid-template-columns: minmax(0, 65fr) minmax(0, 35fr); }
    .column-main { padding-inline-end: 3.5mm; border-inline-end: 2px solid var(--accent); }
    .column-side { font-size: 9pt; }
    * { -webkit-print-color-adjust: exact; print-color-adjust: exact; }
{% endblock %}
